---
import Layout from '../layouts/Layout.astro';

const projectFiles = import.meta.glob('./projects/*.astro', { eager: true });
const projects = Object.entries(projectFiles).map(([path, mod]: [string, any]) => {
  const filename = path.split('/').pop()?.replace('.astro', '') || '';
  const url = `/projects/${filename}`;
  // Extract info if available from exported properties or default to filename/title
  const title = mod.title || mod.frontmatter?.title || filename;
  const description = mod.description || mod.frontmatter?.description || '';
  return {
    url,
    title,
    description,
    filename
  };
});
---

<Layout title="GTREF — Personal Bio & Profile">
	<main class="container">
		<header class="profile-header">
			<div class="avatar-container">
				<div class="avatar-gradient">
					<span class="avatar-text">GT</span>
				</div>
			</div>
			<div class="profile-info">
				<h1 class="name">GTREF</h1>
				<p class="tagline">Software Developer & Systems Enthusiast</p>
				<div class="status-badge">
					<span class="status-dot"></span>
					<span>Building cool projects</span>
				</div>
			</div>
		</header>

		<section class="card bio-section">
			<h2>About Me</h2>
			<p>
				Welcome to my personal profile! I am a passionate developer interested in low-level programming, web development, and software architecture. I love crafting clean, efficient code and exploring modern frameworks and toolings.
			</p>
		</section>

		<section class="card projects-section">
			<h2>Projects</h2>
			<div class="projects-grid">
				{projects.map((project) => (
					<div class="project-card">
						<h3><a href={project.url}>{project.title}</a></h3>
						{project.description && <p>{project.description}</p>}
					</div>
				))}
			</div>
		</section>

		<section class="card snippet-section">
			<div class="snippet-header">
				<div class="window-buttons">
					<span class="dot red"></span>
					<span class="dot yellow"></span>
					<span class="dot green"></span>
				</div>
				<span class="snippet-title">main.c</span>
			</div>
			<pre class="code-block"><code><span class="keyword">#include</span> <span class="string">&lt;stdio.h&gt;</span>

<span class="keyword">int</span> <span class="function">main</span>() {
    <span class="function">printf</span>(<span class="string">"Hello, World\n"</span>);
    <span class="keyword">return</span> <span class="number">0</span>;
}</code></pre>
		</section>

		<section class="card skills-section">
			<h2>Skills & Tech</h2>
			<div class="tags">
				<span class="tag">C / C++</span>
				<span class="tag">JavaScript / TypeScript</span>
				<span class="tag">Astro</span>
				<span class="tag">HTML / CSS</span>
				<span class="tag">Git & GitHub</span>
				<span class="tag">CI/CD</span>
			</div>
		</section>

		<section class="card contact-section">
			<h2>Connect & Contact</h2>
			<p>Feel free to reach out, explore my blog, or check out my repositories.</p>
			<div class="contact-links">
				<a href="https://gtref.github.io/blog" target="_blank" rel="noopener noreferrer" class="button primary">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
					My Blog
				</a>
				<a href="https://github.com/gtref" target="_blank" rel="noopener noreferrer" class="button secondary">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
					GitHub Profile
				</a>
			</div>
		</section>

		<footer>
			<p>&copy; {new Date().getFullYear()} GTREF. Built with Astro.</p>
		</footer>
	</main>
</Layout>

<style>
	.container {
		max-width: 768px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.profile-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}

	.avatar-container {
		flex-shrink: 0;
	}

	.avatar-gradient {
		width: 84px;
		height: 84px;
		border-radius: 50%;
		background: var(--accent-gradient);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1.75rem;
		color: #ffffff;
		box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
	}

	.profile-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.name {
		font-size: 2.25rem;
		font-weight: 700;
		background: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.025em;
	}

	.tagline {
		font-size: 1.1rem;
		color: var(--text-muted);
	}

	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: #10b981;
		margin-top: 0.25rem;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #10b981;
		box-shadow: 0 0 10px #10b981;
	}

	.card {
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		backdrop-filter: blur(12px);
		border-radius: 1rem;
		padding: 1.75rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}

	.card h2 {
		font-size: 1.35rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		color: #f9fafb;
	}

	.projects-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		margin-top: 1rem;
	}

	.project-card {
		background-color: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--card-border);
		border-radius: 0.5rem;
		padding: 1rem;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-2px);
		border-color: rgba(99, 102, 241, 0.4);
	}

	.project-card h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.project-card p {
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.snippet-section {
		padding: 0;
		overflow: hidden;
		background-color: var(--code-bg);
	}

	.snippet-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.25rem;
		background-color: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid var(--card-border);
	}

	.window-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.dot.red { background-color: #ef4444; }
	.dot.yellow { background-color: #f59e0b; }
	.dot.green { background-color: #10b981; }

	.snippet-title {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.code-block {
		padding: 1.25rem 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		overflow-x: auto;
		color: #e5e7eb;
	}

	.keyword { color: #c084fc; font-weight: 500; }
	.function { color: #60a5fa; }
	.string { color: #34d399; }
	.number { color: #f97316; }

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	.tag {
		background-color: rgba(99, 102, 241, 0.12);
		color: #a5b4fc;
		border: 1px solid rgba(99, 102, 241, 0.25);
		padding: 0.4rem 0.85rem;
		border-radius: 2rem;
		font-size: 0.875rem;
		font-weight: 500;
	}

	.contact-links {
		margin-top: 1.25rem;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.button.primary {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--accent-gradient);
		color: #ffffff;
		padding: 0.75rem 1.25rem;
		border-radius: 0.5rem;
		font-weight: 500;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.button.secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--card-border);
		color: #ffffff;
		padding: 0.75rem 1.25rem;
		border-radius: 0.5rem;
		font-weight: 500;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.button.primary:hover,
	.button.secondary:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	footer {
		text-align: center;
		margin-top: 2rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.profile-header {
			flex-direction: column;
			text-align: center;
		}

		.status-badge {
			justify-content: center;
		}
	}
</style>
