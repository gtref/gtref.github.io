---
import Layout from '../layouts/Layout.astro';

const projectFiles = import.meta.glob('./projects/*.astro', { eager: true });
const projects = Object.entries(projectFiles)
  .map(([path, mod]: [string, any]) => {
    const filename = path.split('/').pop()?.replace('.astro', '') || '';
    if (filename === 'index') return null;
    const url = `/projects/${filename}`;
    const title = mod.projectTitle || mod.frontmatter?.projectTitle || mod.title || mod.frontmatter?.title || filename;
    const description = mod.projectDescription || mod.frontmatter?.projectDescription || mod.description || mod.frontmatter?.description || '';
    const tags = mod.tags || mod.frontmatter?.tags || [];
    return {
      url,
      title,
      description,
      tags,
      filename
    };
  })
  .filter(Boolean);

const stacks = ["Next.js", "React.js"];
const languages = [
  "C", "C++", "Python", "HTML", "CSS", "JS", "TS", "PHP", "Bash", "PowerShell", "Astro"
];
---

<Layout title="GTREF — Personal Bio & Profile">
	<main class="container">
		<header class="profile-header">
			<div class="avatar-container">
				<div class="avatar-gradient">
					<span class="avatar-text">GT</span>
				</div>
			</div>
			<div class="profile-info">
				<h1 class="name">GTREF</h1>
				<p class="tagline">Software Developer &amp; Student Builder</p>
				<div class="status-badge">
					<span class="status-dot"></span>
					<span>Year 11 &bull; St Peter's College Palmerston North</span>
				</div>
			</div>
		</header>

		<!-- Bio Section -->
		<section class="card bio-section">
			<div class="section-top">
				<h2>About Me</h2>
				<a href="/about" class="learn-more-link">Read Full Bio &rarr;</a>
			</div>
			<p>
				Kia Ora! I'm <strong>gtref</strong>, a Year 11 student at <strong>St Peter's College Palmerston North</strong> and a passionate developer who loves building projects for the web and low-level computing.
			</p>
			<p class="bio-sub">
				My core frameworks are <strong>Next.js</strong> and <strong>React.js</strong>, and I actively write software in C, C++, Python, HTML, CSS, JS, TS, PHP, Bash, PowerShell, and Astro.
			</p>
			<div class="bio-actions">
				<a href="/about" class="button accent">More About Me</a>
				<a href="/projects" class="button outline">Explore Projects</a>
			</div>
		</section>

		<!-- Stacks & Languages -->
		<section class="card skills-section">
			<h2>Stacks &amp; Technologies</h2>

			<div class="skills-group">
				<span class="group-label">Core Stacks</span>
				<div class="tags">
					{stacks.map((stack) => (
						<span class="tag stack-tag">
							<span class="tag-bullet">&bull;</span>
							{stack}
						</span>
					))}
				</div>
			</div>

			<div class="skills-group">
				<span class="group-label">Languages</span>
				<div class="tags">
					{languages.map((lang) => (
						<span class="tag lang-tag">{lang}</span>
					))}
				</div>
			</div>
		</section>

		<!-- Projects Section -->
		<section class="card projects-section">
			<div class="section-top">
				<h2>Featured Projects</h2>
				<a href="/projects" class="learn-more-link">View All ({projects.length}) &rarr;</a>
			</div>
			<div class="projects-grid">
				{projects.map((project) => (
					<div class="project-card">
						<h3><a href={project?.url}>{project?.title}</a></h3>
						{project?.description && <p class="project-desc">{project.description}</p>}
						{project?.tags && project.tags.length > 0 && (
							<div class="card-tags">
								{project.tags.map((tag: string) => (
									<span class="mini-tag">{tag}</span>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>

		<!-- Contact Section -->
		<section class="card contact-section">
			<h2>Connect &amp; Contact</h2>
			<p>Feel free to reach out, explore my blog, or check out my repositories.</p>
			<div class="contact-links">
				<a href="https://gtref.github.io/blog" target="_blank" rel="noopener noreferrer" class="button primary">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
					My Blog
				</a>
				<a href="https://github.com/gtref" target="_blank" rel="noopener noreferrer" class="button secondary">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
					GitHub Profile
				</a>
			</div>
		</section>

		<footer>
			<p>&copy; {new Date().getFullYear()} GTREF. Built with Astro.</p>
		</footer>
	</main>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.profile-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.avatar-container {
		flex-shrink: 0;
	}

	.avatar-gradient {
		width: 88px;
		height: 88px;
		border-radius: 1.25rem;
		background: var(--accent-gradient);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 1.85rem;
		color: #ffffff;
		box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
		transition: transform 0.25s ease;
	}

	.avatar-gradient:hover {
		transform: rotate(3deg) scale(1.05);
	}

	.profile-info {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.name {
		font-size: 2.35rem;
		font-weight: 800;
		background: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.tagline {
		font-size: 1.08rem;
		color: var(--text-muted);
	}

	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: #10b981;
		font-weight: 500;
		margin-top: 0.2rem;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #10b981;
		box-shadow: 0 0 8px #10b981;
		flex-shrink: 0;
	}

	.card {
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-radius: 1.15rem;
		padding: 1.85rem;
		box-shadow: var(--shadow-card);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		border-color: var(--card-border-hover);
	}

	.section-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.75rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.card h2 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text-heading);
	}

	.learn-more-link {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--accent-color);
	}

	.bio-section p {
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--text-main);
	}

	.bio-sub {
		margin-top: 0.6rem;
		color: var(--text-muted);
	}

	.bio-actions {
		display: flex;
		gap: 0.75rem;
		margin-top: 1.25rem;
		flex-wrap: wrap;
	}

	.skills-group {
		margin-top: 1.25rem;
	}

	.skills-group:first-of-type {
		margin-top: 0.85rem;
	}

	.group-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.tag {
		background-color: var(--tag-bg);
		color: var(--tag-text);
		border: 1px solid var(--tag-border);
		padding: 0.35rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.85rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.tag:hover {
		transform: translateY(-1px);
		border-color: var(--accent-color);
	}

	.tag.stack-tag {
		font-weight: 600;
		background: rgba(99, 102, 241, 0.16);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.tag.stack-tag .tag-bullet {
		color: var(--accent-color);
		font-size: 1.1rem;
		line-height: 0;
	}

	.tag.lang-tag {
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}

	.projects-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		margin-top: 1rem;
	}

	.project-card {
		background-color: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: 0.75rem;
		padding: 1.25rem;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.project-card:hover {
		transform: translateY(-2px);
		border-color: var(--card-border-hover);
		box-shadow: var(--shadow-hover);
	}

	.project-card h3 {
		font-size: 1.1rem;
		font-weight: 600;
	}

	.project-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.25rem;
	}

	.mini-tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		background: var(--tag-bg);
		color: var(--tag-text);
		border: 1px solid var(--tag-border);
		padding: 0.15rem 0.5rem;
		border-radius: 0.35rem;
	}

	.contact-links {
		margin-top: 1.25rem;
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 1.25rem;
		border-radius: 0.6rem;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.button.accent {
		background: var(--accent-gradient);
		color: #ffffff;
		box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
	}

	.button.outline {
		background: transparent;
		border: 1px solid var(--card-border);
		color: var(--text-heading);
	}

	.button.primary {
		background: var(--accent-gradient);
		color: #ffffff;
	}

	.button.secondary {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		color: var(--text-heading);
	}

	.button:hover {
		transform: translateY(-1px);
		opacity: 0.95;
	}

	footer {
		text-align: center;
		margin-top: 1rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.profile-header {
			flex-direction: column;
			text-align: center;
		}

		.status-badge {
			justify-content: center;
		}

		.section-top {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
