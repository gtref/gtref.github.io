---
import ProjectLayout from '../../layouts/Layout_projects.astro';

export const projectTitle = "Contributer agreement";
export const projectDescription = "A simple code of conduct that enforces fair and equil behavour.";
export const tags = ['Code Of Conduct'];
export const githubUrl = "https://github.com/gtref/Contributor_aggrement";
export const liveUrl = "https://gtref.github.io/Contributor_aggrement/";
---

<ProjectLayout
  title="Contributor_aggrement | Portfolio"
  projectTitle={projectTitle}
  projectDescription={projectDescription}
  tags={tags}
  githubUrl={githubUrl}
  liveUrl={liveUrl}
>
  <p>
Contributor_aggrement is a simple aggreement for contributers that provides baseline rules for contributing to repos while enforcing/premoting fair behavour towards 
maintainers and contributers alike.
</p>
</ProjectLayout>
