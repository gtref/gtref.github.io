---
import ProjectLayout from '../../layouts/Layout_projects.astro';

export const projectTitle = "satiscode";
export const projectDescription = "A lightweight IDE designed to be fast and minimal by removing AI bloat and heavy Node dependencies.";
export const tags = ['Node.js', 'satiscode', 'IDE'];
export const githubUrl = "https://github.com/gtref/satiscode";
export const liveUrl = "https://gtref.github.io/satiscode";
---

<ProjectLayout
  title="satiscode | Portfolio"
  projectTitle={projectTitle}
  projectDescription={projectDescription}
  tags={tags}
  githubUrl={githubUrl}
  liveUrl={liveUrl}
>
  <p>Satiscode is a simple IDE designed to be light by design by ditching all ai features and ditching heavy node.js librarys we are able to bring you an ide with a 
  <strong>450MB Size</strong> that will never go above or below that size.</p>
</ProjectLayout>
