---
import ProjectLayout from '../../layouts/Layout_projects.astro';

export const projectTitle = "anvil-language";
export const projectDescription = "A simple go based and written interpreted language.";
export const tags = ['GO', 'Language', 'Interpreter'];
export const githubUrl = "https://github.com/anvil-language/anvil-interpreter";
export const liveUrl = "https://anvil-language.github.io/anvil-lang"
---

<ProjectLayout
  title="ronna-spark-ui | Portfolio"
  projectTitle={projectTitle}
  projectDescription={projectDescription}
  tags={tags}
  githubUrl={githubUrl}
  liveUrl={liveUrl}
>
  <p>Anvil-Language is a simple programming language that I wrote in go lang to solve a problem I have, I do not like python. So i did the next best thing, I made a 
  interpreted language that is like Python while retaining some of the core C syntax rules.</p>
</ProjectLayout>
