---
import ProjectLayout from '../../layouts/Layout_projects.astro';

export const projectTitle = "ronna-spark-ui";
export const projectDescription = "A lightweight UI package designed to cut the crap.";
export const tags = ['Node.js', 'UI', 'CDN', 'NPM'];
export const githubUrl = "https://github.com/gtref/-ronna-spark-ui";
---

<ProjectLayout
  title="ronna-spark-ui | Portfolio"
  projectTitle={projectTitle}
  projectDescription={projectDescription}
  tags={tags}
  githubUrl={githubUrl}
>
  <p>@ronna/spark-ui Is a lit powered HTML UI package that can be accessed by cdn. Its purpose Is to create nice ui elements without taking up too much space </p>
</ProjectLayout>
