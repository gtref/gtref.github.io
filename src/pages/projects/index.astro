---
import Layout from '../../layouts/Layout.astro';

const projectFiles = import.meta.glob('./*.astro', { eager: true });

const projects = Object.entries(projectFiles)
  .map(([path, mod]: [string, any]) => {
    const filename = path.split('/').pop()?.replace('.astro', '') || '';
    if (filename === 'index') return null;
    const url = `/projects/${filename}`;
    const title = mod.title || mod.frontmatter?.title || filename;
    const description = mod.description || mod.frontmatter?.description || '';
    return {
      url,
      title,
      description,
      filename
    };
  })
  .filter(Boolean);
---

<Layout title="Projects | GTREF">
  <main class="container">
    <header class="page-header">
      <a href="/" class="back-link">&larr; Back to Home</a>
      <h1 class="title">Projects</h1>
      <p class="subtitle">A list of projects and applications built by GTREF.</p>
    </header>

    <section class="card projects-section">
      <div class="projects-grid">
        {projects.map((project) => (
          <div class="project-card">
            <h2><a href={project?.url}>{project?.title}</a></h2>
            {project?.description && <p>{project.description}</p>}
          </div>
        ))}
      </div>
    </section>

    <footer>
      <p>&copy; {new Date().getFullYear()} GTREF. Built with Astro.</p>
    </footer>
  </main>
</Layout>

<style>
  .container {
    max-width: 768px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .title {
    font-size: 2.25rem;
    font-weight: 700;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.025em;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(12px);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .project-card {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--card-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: rgba(99, 102, 241, 0.4);
  }

  .project-card h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .project-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  footer {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
