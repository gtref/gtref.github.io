---
import Layout from '../../layouts/Layout.astro';

const projectFiles = import.meta.glob('./*.astro', { eager: true });

const projects = Object.entries(projectFiles)
  .map(([path, mod]: [string, any]) => {
    const filename = path.split('/').pop()?.replace('.astro', '') || '';
    if (filename === 'index') return null;
    const url = `/projects/${filename}`;
    const title = mod.projectTitle || mod.frontmatter?.projectTitle || mod.title || mod.frontmatter?.title || filename;
    const description = mod.projectDescription || mod.frontmatter?.projectDescription || mod.description || mod.frontmatter?.description || '';
    const tags = mod.tags || mod.frontmatter?.tags || [];
    return {
      url,
      title,
      description,
      tags,
      filename
    };
  })
  .filter(Boolean);
---

<Layout title="Projects | GTREF" description="Software projects and experiments built by GTREF.">
  <main class="container">
    <header class="page-header">
      <a href="/" class="back-link">&larr; Back to Home</a>
      <h1 class="title">Projects</h1>
      <p class="subtitle">A list of projects, tools, and applications built by GTREF.</p>
    </header>

    <section class="card projects-section">
      <div class="projects-grid">
        {projects.map((project) => (
          <div class="project-card">
            <h2><a href={project?.url}>{project?.title}</a></h2>
            {project?.description && <p class="project-desc">{project.description}</p>}
            {project?.tags && project.tags.length > 0 && (
              <div class="card-tags">
                {project.tags.map((tag: string) => (
                  <span class="mini-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <footer>
      <p>&copy; {new Date().getFullYear()} GTREF. Built with Astro.</p>
    </footer>
  </main>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .title {
    font-size: 2.35rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.025em;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 1.15rem;
    padding: 1.85rem;
    box-shadow: var(--shadow-card);
  }

  .projects-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .project-card {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    padding: 1.35rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--card-border-hover);
    box-shadow: var(--shadow-hover);
  }

  .project-card h2 {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .project-card h2 a {
    color: var(--text-heading);
  }

  .project-card h2 a:hover {
    color: var(--accent-color);
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--tag-bg);
    color: var(--tag-text);
    border: 1px solid var(--tag-border);
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
  }

  footer {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
